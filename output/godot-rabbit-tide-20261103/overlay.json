{
  "sources": [
    {
      "id": "rabbit-tide-original-20261103",
      "path": "art-reference-official/卡面-按版本/13_喧哗烩战/",
      "evidence": "24700–24708、25000–25008完整原PNG目检。觅食为抽牌；孤独的美食兔为烹饪触发；萌动免疫战斗伤害、增强追猎；塑潮使者4/5远程；永生之汐含帷幕。"
    },
    {
      "id": "rabbit-tide-official-20220414",
      "url": "https://www.taptap.cn/moment/263404919191503871",
      "evidence": "官方海原贝戟离场若手中无咏流则给一张；永生之汐进场眩晕、在场帷幕、离场全敌方角色2伤。"
    },
    {
      "id": "rabbit-tide-official-20220331",
      "url": "https://www.taptap.cn/moment/258340769469827609",
      "evidence": "唤潮眩晕并压制降低2力量；萌动免战伤并在敌方不明食材/黑暗料理历史后获得追猎。"
    },
    {
      "id": "rabbit-tide-spear-derivative",
      "url": "https://gamerch.com/onmyojicard/353804",
      "evidence": "相关卡：海原贝戟1勾0/2；咏流1勾召唤贝戟，增强当千姬使用牌时此牌获得瞬发。主体觉醒继续采用中文PNG版本。"
    },
    {
      "id": "rabbit-recipe-derivative",
      "url": "https://gamerch.com/onmyojicard/354067",
      "evidence": "兔丸特制食谱：已获得山珍追加投射3，海味追加牌手恢复5，时蔬追加压制-3/-3。"
    },
    {
      "id": "rabbit-unknown-dark",
      "url": "https://gamerch.com/onmyojicard/354060",
      "evidence": "相关卡：不明食材使式神获得4破甲；合成佳肴时改成黑暗料理；黑暗料理瞬发、使一个式神获得6破甲。"
    },
    {
      "id": "cooking-chinese-mechanics",
      "url": "https://www.taptap.cn/moment/341546240254673892",
      "evidence": "玩家实测说明黑暗料理视为佳肴参与猫掌柜效果，但厨艺研行不使用它；解忧移除海原贝戟不提供咏流，复杂移除边界待核。"
    }
  ],
