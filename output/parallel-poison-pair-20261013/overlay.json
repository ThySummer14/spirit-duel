    },
    {
      "id": "poison-pair-mode-2023-03-09",
      "url": "https://www.taptap.cn/moment/382609474805825905",
      "evidence": "觉醒清姬全体1伤、剧毒之盾屏障投射、喷泉自身1破甲属于有个牌局调整；未推广常规。"
    },
    {
      "id": "poison-pair-jumper-guide",
      "url": "https://www.taptap.cn/moment/15221946199312146",
      "evidence": "官方攻略组跳跳弟弟百科：承伤/永久生命、破甲角色仍可被萤草回复。"
    },
    {
      "id": "poison-pair-tank-analysis",
      "url": "https://www.taptap.cn/moment/15221196425529867",
      "evidence": "狸猫会原作者：腐坏直拳相当至少+2伤；甜蜜的负担护牌手，尸毒受到超14伤仍触发。"
    },
    {
      "id": "poison-pair-control-analysis",
      "url": "https://www.taptap.cn/moment/15227166597842769",
      "evidence": "狸猫会原作者：公测清姬改为未破甲转换、蛇行击逐张成长回手、剧毒之盾战斗伤害后破甲、形态时机。"
    },
    {
      "id": "poison-pair-priority-analysis",
      "url": "https://www.taptap.cn/moment/467093870207830538",
      "evidence": "原作者机制记录：伤害转换优于伤害转移/通常防护，破甲不是中毒。"
    },
    {
      "id": "poison-snake-balance-2020-06-24",
      "url": "https://ssr.163.com/news/update/20200623/30294_888590.html",
      "evidence": "常规平衡：蛇行击改为2伤，使用后回手并失去此能力；覆盖旧1伤按破甲无限成长。原始HTML已归档。"
    }
  ],
