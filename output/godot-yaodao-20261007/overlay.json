    {
      "id": "yaodao-balance-2020-12-24",
      "url": "https://www.taptap.cn/moment/90930908776893040",
      "evidence": "官方账号维护公告：不祥之刃调整为消灭敌方式神时抽一张牌；战斗牌能力持续到对应战斗结束。"
    },
    {
      "id": "yaodao-fix-2022-01-26",
      "url": "https://www.taptap.cn/moment/235144264613364682",
      "evidence": "官方修复不祥击杀独眼小僧后妖刀被其投射气绝时未抽牌，证明已满足击杀条件不受之后气绝取消。"
    },
    {
      "id": "yaodao-tanukikai-review",
      "url": "https://www.taptap.cn/moment/15223033941722667",
      "evidence": "原作者狼眼公测卡评：基础打脸给战斗牌瞬发、觉醒永久迅捷、万华先额外击中再普通交战。"
    },
    {
      "id": "yaodao-instant-faq",
      "url": "https://www.bilibili.com/opus/333469661823472230",
      "evidence": "原作者式神浅谈：打脸后先使用一闪会浪费瞬发；瞬发与队友共享一次；全部五种战斗牌。"
    },
    {
      "id": "yaodao-combat-faq",
      "url": "https://www.taptap.cn/moment/15225930238658237",
      "evidence": "原作者实测FAQ：万华先击致死不受反击，打牌手有两次独立命中，战斗护甲只获得一次。该帖旧版不祥打脸抽牌被后续公告淘汰。"
    },
    {
      "id": "yaodao-armor-lifetime",
      "url": "https://www.taptap.cn/moment/15218393770626608",
      "evidence": "官方基础卡面属性：护甲自己回合开始清除；与2020战斗牌力量和能力期限分开。"
    },
    {
      "id": "yaodao-combat-armor-example",
      "url": "https://www.taptap.cn/moment/15218530131643593",
      "evidence": "官方酒吞百科明确狂气战斗牌取得的护甲到下个己方回合消失，支持战斗护甲的共享寿命。"
    }
  ],
